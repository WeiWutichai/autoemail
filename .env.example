# ===== App =====
NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# ===== Docker Compose host ports (เปลี่ยนเมื่อพอร์ตชนกับ service อื่นในเครื่อง) =====
# ถ้าเปลี่ยน POSTGRES_HOST_PORT / REDIS_HOST_PORT ให้แก้พอร์ตใน DATABASE_URL / REDIS_URL ด้านล่างให้ตรงกัน
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=3001
WEB_HOST_PORT=3000

# ===== Database (ระบบเอง) =====
DATABASE_URL=postgresql://erpmail:erpmail@localhost:5432/erpmail?schema=public
# ใช้กับ pnpm test:e2e เท่านั้น — ชื่อ database ต้องลงท้ายด้วย _test (ข้อมูลจะถูกล้างทุกครั้งที่รัน)
TEST_DATABASE_URL=postgresql://erpmail:erpmail@localhost:5432/erpmail_test?schema=public

# ===== Redis (BullMQ) =====
REDIS_URL=redis://localhost:6379
# ใช้กับ pnpm test:e2e เท่านั้น — db นี้จะถูกล้างทุกครั้งที่รัน
TEST_REDIS_URL=redis://localhost:6379/15

# ===== Auth =====
# สร้างด้วย: openssl rand -base64 48 (ต้องยาวอย่างน้อย 32 ตัวอักษร ไม่งั้น api ไม่ boot)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ===== Encryption (รหัสผ่าน ERP DB และ SMTP ใน DB) =====
# 32 bytes base64 — สร้างด้วย: openssl rand -base64 32
# ห้ามเปลี่ยนหลังมีข้อมูลแล้ว ยกเว้นผ่าน CLI rotate-key
MASTER_KEY=change-me-32-bytes-base64

# ===== Seed admin คนแรก (ใช้ครั้งเดียวตอน pnpm db:seed) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrator

# ===== Storage =====
ATTACHMENT_DIR=./storage/attachments
LOG_RETENTION_DAYS=90

# ===== Worker =====
# ความถี่ที่ worker ตรวจหา sync config ที่ถึงรอบ (วินาที)
SYNC_TICK_SEC=30
SEND_CONCURRENCY=2
SEND_RATE_PER_SEC=1
SEND_MAX_ATTEMPTS=5
ERP_QUERY_TIMEOUT_MS=10000
ERP_MAX_CONNECTIONS=2

# ===== SMTP default (ใส่ได้ในหน้า Admin ด้วย ค่านี้ใช้เป็น fallback / ส่งเมลแจ้งเตือน Admin) =====
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=ERP Mail Relay
SMTP_FROM_EMAIL=noreply@example.com
