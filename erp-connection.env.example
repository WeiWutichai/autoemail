# ข้อมูลเชื่อมต่อ ERP (SQL Server) — copy เป็น erp-connection.local.env แล้วกรอกค่า
# erp-connection.local.env ถูก gitignore ไว้ ห้าม commit
# ใน M2 จะมีคำสั่ง import เข้า DB (รหัสผ่านเข้ารหัส AES-256-GCM) แล้วลบไฟล์ local ทิ้งได้

# ชื่อที่จะแสดงในหน้า /connections
ERP_NAME=ERP-HQ
# ค่าที่รองรับ: MSSQL | ORACLE | MYSQL | POSTGRES
ERP_DB_TYPE=MSSQL

# IP หรือ hostname ของ SQL Server (ถ้าใช้ named instance เช่น SERVER\SQLEXPRESS ให้ใส่ชื่อ instance ใน ERP_INSTANCE)
ERP_HOST=
ERP_INSTANCE=
ERP_PORT=1433
ERP_DATABASE=

# user ฝั่ง ERP ควรมีสิทธิ์ SELECT เท่านั้น (อย่างน้อย PurchaseRequisitionHdr, PurchaseOrderHdr, Z_MaIL)
ERP_USERNAME=
ERP_PASSWORD=

# เข้ารหัสการเชื่อมต่อ (TLS)
ERP_SSL=false
# true ถ้า SQL Server ใช้ certificate ที่ออกเอง (self-signed) ซึ่งพบบ่อยใน server ภายใน
ERP_TRUST_SERVER_CERT=true
